# Base de datos — obligatoria, la instancia inyecta la suya propia.
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# Embeddings
# local: sentence-transformers local (sin API key, para desarrollo offline)
# bgem3: servicio remoto self-hosted (producción)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
BGEM3_URL=http://localhost:8000

# Dónde persisten los PDFs descargados (extra opcional [ingesta]). Default: ./document_store_data
KM_DOCUMENT_STORE_DIR=

# ── Servidor HTTP opcional (server.py, extra opcional [servidor]) ──────────────
# Un servidor = un tenant. Ver el docstring de server.py para el contrato completo.
KM_TENANT_ID=
KM_API_KEYS=[{"clave": "cambiar-por-una-clave-real", "nivel": "lectura"}]
KM_SERVER_REQUIRE_HTTPS=true
KM_SERVER_RATE_LIMIT_RPM=300
KM_SERVER_PROYECCION_INTERVALO_SEG=30
